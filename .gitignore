/target
# Cargo.lock is not committed: this is a library crate, so downstream builds
# resolve their own graph and a committed lock here would only ever describe
# CI's choices, never a consumer's.
Cargo.lock
!/tools/smoke/Cargo.lock
!/tools/timing-probe/Cargo.lock
!/tools/benchmark/Cargo.lock
/tools/*/target/
/tools/benchmark/macos/.build/
/tools/benchmark/dist/

/tools/*/__pycache__/
